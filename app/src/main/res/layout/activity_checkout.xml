<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <!-- Header Toolbar -->
    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back_blue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Giao dịch"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Thông tin vé (Hiệu ứng khoét 2 bên) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_ticket_white"
                    android:elevation="2dp"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/ivPoster"
                        android:layout_width="60dp"
                        android:layout_height="85dp"
                        android:background="@drawable/bg_placeholder"
                        android:scaleType="centerCrop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvMovieTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="Tên phim"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvFormat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Định dạng"
                            android:textColor="@color/gray_text"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvCinemaName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Rạp chiếu"
                            android:textColor="@color/gray_text"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvTimeAndDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Giờ - Ngày"
                            android:textColor="@color/black"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Vòng tròn cắt trái -->
                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="-8dp"
                    android:elevation="3dp"
                    android:background="@drawable/shape_circle_f5f5f5" />

                <!-- Vòng tròn cắt phải -->
                <View
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="-8dp"
                    android:elevation="3dp"
                    android:background="@drawable/shape_circle_f5f5f5" />
            </RelativeLayout>

            <!-- Thông tin giao dịch -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="4dp"
                android:text="Thông tin giao dịch"
                android:textColor="@color/gray_text"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/white"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Row: Seats -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/tvSeatsDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@id/tvSeatsPrice"
                        android:layout_marginEnd="16dp"
                        android:text="Ghế"
                        android:textColor="@color/black"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvSeatsPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="0đ"
                        android:textColor="@color/black"
                        android:textSize="13sp" />
                </RelativeLayout>

                <!-- Container cho Combos -->
                <LinearLayout
                    android:id="@+id/layoutCombos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Đường kẻ đứt phân cách với Tổng cộng -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginVertical="12dp"
                    android:background="@drawable/bg_dashed_line"
                    android:layerType="software" />

                <!-- Row: Total -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toStartOf="@id/tvSubTotal"
                        android:layout_marginEnd="16dp"
                        android:text="Tổng Cộng"
                        android:textColor="@color/black"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvSubTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="0đ"
                        android:textColor="@color/orange_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Payment Methods -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="20dp"
                android:text="Thông tin thanh toán"
                android:textColor="@color/gray_text"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/layoutPaymentMethods"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/white"
                android:orientation="vertical">

                <!-- OnePay -->
                <LinearLayout
                    android:id="@+id/payOnePay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/ic_onepay"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="OnePay - Visa, Master, JCB,... / ATM / QR Ngân hàng" android:textColor="@color/black" android:textSize="13sp"/>
                    <RadioButton android:id="@+id/rbOnePay" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="@color/orange_primary" android:clickable="false" android:minHeight="0dp" android:minWidth="0dp"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_gray" android:layout_marginStart="16dp"/>

                <!-- ShopeePay -->
                <LinearLayout
                    android:id="@+id/payShopee"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/ic_sp"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Ví ShopeePay - Giảm đến 20% tối đa 50K" android:textColor="@color/black" android:textSize="13sp"/>
                    <RadioButton android:id="@+id/rbShopee" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="@color/orange_primary" android:clickable="false" android:minHeight="0dp" android:minWidth="0dp"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_gray" android:layout_marginStart="16dp"/>

                <!-- ZaloPay -->
                <LinearLayout
                    android:id="@+id/payZalo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/ic_zalopay"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Zalopay - Bạn mới nhập mã GIAMSAU giảm 50%" android:textColor="@color/black" android:textSize="13sp"/>
                    <RadioButton android:id="@+id/rbZalo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="@color/orange_primary" android:clickable="false" android:minHeight="0dp" android:minWidth="0dp"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider_gray" android:layout_marginStart="16dp"/>

                <!-- MoMo -->
                <LinearLayout
                    android:id="@+id/payMomo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="16dp"
                    android:gravity="center_vertical"
                    android:background="?android:attr/selectableItemBackground">
                    <ImageView android:layout_width="28dp" android:layout_height="28dp" android:background="@drawable/ic_momo"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:text="Ví MoMo - Nhập mã MOMODAY hoàn tiền 2%" android:textColor="@color/black" android:textSize="13sp"/>
                    <RadioButton android:id="@+id/rbMomo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:buttonTint="@color/orange_primary" android:clickable="false" android:minHeight="0dp" android:minWidth="0dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Terms -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:text="(*) Bằng việc click vào THANH TOÁN, bạn xác nhận đã đọc và đồng ý các điều khoản giao dịch trực tuyến."
                android:textColor="@color/gray_text"
                android:textSize="11sp" />
                
            <View android:layout_width="match_parent" android:layout_height="40dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Checkout Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/btnCheckout"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:layout_centerVertical="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tổng Cộng"
                    android:textColor="@color/gray_text"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tvFinalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0đ"
                    android:textColor="@color/orange_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCheckout"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_btn_orange"
                android:text="Thanh toán"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>

</LinearLayout>
