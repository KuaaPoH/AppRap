<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:orientation="vertical">

    <!-- Toolbar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/white"
        android:elevation="2dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back_blue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Admin Dashboard"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- Date Filter & Cinema Filter -->
            <LinearLayout
                android:id="@+id/layoutFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Lọc theo Rạp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusTopStart="16dp">
                    <AutoCompleteTextView
                        android:id="@+id/spinnerCinemaFilter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:text="Tất cả rạp"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDateFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/bg_white_rounded_12"
                    android:elevation="1dp"
                    android:text="Ngày Lọc"
                    android:textColor="#034EA2"
                    android:textStyle="bold"
                    android:paddingHorizontal="16dp"
                    android:drawableStart="@drawable/ic_calendar_outline"
                    android:drawablePadding="8dp"
                    android:drawableTint="#034EA2"/>
            </LinearLayout>

            <!-- Revenue Block (Bento 1 - Wide) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRevenue"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E8F5E9"
                app:layout_constraintTop_toBottomOf="@id/layoutFilter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tổng doanh thu"
                            android:textColor="#2E7D32"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTotalRevenue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0 VNĐ"
                            android:textColor="#1B5E20"
                            android:textSize="22sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/bear"
                        app:strokeColor="#034EA2"
                        app:strokeWidth="2dp"
                        android:padding="2dp"
                        app:shapeAppearanceOverlay="@style/CircleImage" />
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Statistics Block (Bento 2 - Large) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardStats"
                android:layout_width="0dp"
                android:layout_height="180dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/white"
                app:layout_constraintTop_toBottomOf="@id/cardRevenue"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/guideline_v50">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thống kê"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="30dp"
                        android:layout_height="3dp"
                        android:layout_marginTop="4dp"
                        android:background="#F58020" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="12dp"
                        android:columnCount="2"
                        android:rowCount="2">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                            <TextView android:id="@+id/tvMovieCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#034EA2" android:textSize="18sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Phim" android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:orientation="vertical">
                            <TextView android:id="@+id/tvCinemaCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#034EA2" android:textSize="18sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rạp" android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginTop="12dp" android:orientation="vertical">
                            <TextView android:id="@+id/tvShowtimeCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#034EA2" android:textSize="18sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Suất chiếu" android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_marginTop="12dp" android:orientation="vertical">
                            <TextView android:id="@+id/tvProductCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="#034EA2" android:textSize="18sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sản phẩm" android:textSize="11sp" />
                        </LinearLayout>
                    </GridLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Manage Movies (Bento 3 - Square) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardManageMovies"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFE0B2"
                app:layout_constraintTop_toBottomOf="@id/cardRevenue"
                app:layout_constraintStart_toEndOf="@id/guideline_v50"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/movies" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Quản lý Phim" android:textColor="#E65100" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Manage Cinemas (Bento 4 - Square) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardManageCinemas"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E1F5FE"
                app:layout_constraintTop_toBottomOf="@id/cardManageMovies"
                app:layout_constraintStart_toEndOf="@id/guideline_v50"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_cinema" app:tint="#01579B" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Quản lý Rạp" android:textColor="#01579B" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Manage Showtimes (Bento 5 - Square) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardManageShowtimes"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E8F5E9"
                app:layout_constraintTop_toBottomOf="@id/cardStats"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/guideline_v50">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_calendar_outline" app:tint="#1B5E20" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Suất chiếu" android:textColor="#1B5E20" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Manage Products (Bento 6 - Square) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardManageProducts"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F3E5F5"
                app:layout_constraintTop_toBottomOf="@id/cardStats"
                app:layout_constraintStart_toEndOf="@id/guideline_v50"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_cart_outline" app:tint="#4A148C" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Star Shop" android:textColor="#4A148C" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Manage Rooms (Bento 7 - Square) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardManageRooms"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFF3E0"
                app:layout_constraintTop_toBottomOf="@id/cardManageShowtimes"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/guideline_v50">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_location" app:tint="#E65100" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Phòng chiếu" android:textColor="#E65100" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Manage Banners (Bento 8 - Square) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardManageBanners"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FCE4EC"
                app:layout_constraintTop_toBottomOf="@id/cardManageProducts"
                app:layout_constraintStart_toEndOf="@id/guideline_v50"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" app:tint="#880E4F" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Banner" android:textColor="#880E4F" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Manage News (Bento 9 - Wide) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardManageNews"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#E3F2FD"
                app:layout_constraintTop_toBottomOf="@id/cardManageRooms"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_news" app:tint="#0277BD" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Tin tức &amp; Đánh giá" android:textColor="#0277BD" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Manage Users (Bento 10 - Square) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardManageUsers"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#EFEBE9"
                app:layout_constraintTop_toBottomOf="@id/cardManageNews"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/guideline_v50">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_person_outline" app:tint="#5D4037" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Người dùng" android:textColor="#5D4037" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Manage Combos (Bento 11 - Square) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardManageCombos"
                android:layout_width="0dp"
                android:layout_height="82dp"
                android:layout_marginTop="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FFF9C4"
                app:layout_constraintTop_toBottomOf="@id/cardManageNews"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/guideline_v50"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_nav_ticket" app:tint="#F57F17" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Combo Bắp Nước" android:textColor="#F57F17" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guideline_v50"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.55" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
