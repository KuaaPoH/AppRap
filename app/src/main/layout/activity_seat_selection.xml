<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Header Toolbar -->
    <RelativeLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_arrow_back_blue"
            app:tint="@color/galaxy_blue" />

        <TextView
            android:id="@+id/tvCinemaName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Galaxy CineX - Hanoi Centre"
            android:textColor="@color/galaxy_blue"
            android:textSize="16sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider_gray" />

    <!-- Movie & Showtime Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMovieTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Tên phim đang chọn"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFormat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2D LỒNG TIẾNG"
                android:textColor="@color/gray_text"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvShowtime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_edittext"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="12:30"
            android:textColor="@color/black"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Seat Map Area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp"
                android:gravity="center_horizontal">

                <!-- Seat Grid Container -->
                <LinearLayout
                    android:id="@+id/layoutSeatContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Screen Indicator -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:text="MÀN HÌNH"
                    android:textColor="@color/gray_text"
                    android:textSize="12sp" />

                <View
                    android:layout_width="300dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="8dp"
                    android:background="@color/orange_primary" />
            </LinearLayout>
        </HorizontalScrollView>
    </ScrollView>

    <!-- Legend & Checkout Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F9F9F9"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Legend -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="2">

            <LinearLayout android:gravity="center_vertical" android:layout_margin="4dp">
                <View android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/bg_placeholder" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Ghế đơn" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:gravity="center_vertical" android:layout_margin="4dp">
                <View android:layout_width="16dp" android:layout_height="16dp" android:background="@drawable/bg_btn_outline_blue" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Ghế đôi" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:gravity="center_vertical" android:layout_margin="4dp">
                <View android:layout_width="16dp" android:layout_height="16dp" android:background="#FFD700" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Ghế VIP" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:gravity="center_vertical" android:layout_margin="4dp">
                <View android:layout_width="16dp" android:layout_height="16dp" android:background="#EAEAEA" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Đã bán" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:gravity="center_vertical" android:layout_margin="4dp">
                <View android:layout_width="16dp" android:layout_height="16dp" android:background="@color/orange_primary" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" Đang chọn" android:textSize="12sp" />
            </LinearLayout>
        </GridLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/divider_gray" />

        <!-- Selection Summary & Button -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/btnContinue"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSelectedSeats"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chưa chọn ghế"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvTotalPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tổng Cộng: 0đ"
                    android:textColor="@color/orange_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnContinue"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:background="@drawable/bg_btn_orange"
                android:text="Tiếp tục"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold" />
        </RelativeLayout>
    </LinearLayout>

</LinearLayout>
